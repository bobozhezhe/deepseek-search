# Copy this file to .env and fill in your key.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: local port (default 3000)
# PORT=3000

# Optional: bind address (default 127.0.0.1 — keeps the app local-only)
# HOST=127.0.0.1

# Optional: override the API base URL (only useful for testing with a mock)
# DEEPSEEK_API_BASE=https://api.deepseek.com
